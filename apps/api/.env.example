NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3001
APP_TRUST_PROXY=false
LOG_LEVEL=info
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Agrogest_VSM
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_SCHEMA=public
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
# Safety switch used only by `pnpm --filter @agrogest/api bootstrap:database`.
# The command also refuses to run unless DB_SCHEMA is empty.
ALLOW_DATABASE_BOOTSTRAP=false
# In Docker Compose production, the API reaches PostgreSQL through service `db`.
# DB_HOST=db
# DB_PORT=5432
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=150d
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_BLOCK_MS=300000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# API key for the protected Cost-Build read-only export endpoint.
COST_BUILD_API_KEY=replace-with-cost-build-api-key
# WeatherLink v2. Rotate exposed credentials before enabling this integration.
WEATHERLINK_ENABLED=false
WEATHERLINK_API_KEY=
WEATHERLINK_API_SECRET=
# Legacy compatibility; ignored by direct-query mode.
WEATHERLINK_DAILY_SYNC_HOUR=8
WEATHERLINK_TIME_ZONE=America/Lima
WEATHERLINK_CATCHUP_MAX_DAYS=30
WEATHERLINK_REQUEST_TIMEOUT_MS=8000
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=VSM
SEED_ADMIN_EMAIL=admin@agrogestvsm.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
